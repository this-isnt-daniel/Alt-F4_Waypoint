# Database Configuration
# The main Postgres credentials and database name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waypoint

# Complete Database URL for SQLAlchemy and Alembic
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/waypoint

# Security
SECRET_KEY=waypoint-driver-hackathon-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend Configuration
# URL where the frontend expects to reach the backend API
VITE_API_URL=http://localhost:8000/api/v1

# Backend Configuration
# Allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
