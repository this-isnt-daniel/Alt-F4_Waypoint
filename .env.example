# Waypoint Environment Variables Example
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env (or copy in backend folder)

# PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/waypoint

# Auth & Security
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# MinIO / S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=waypoint-evidence
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
